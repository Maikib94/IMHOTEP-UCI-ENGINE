                            </div>
                            <div style={{ fontSize: '0.44rem', opacity: 0.55, marginTop: 2, fontWeight: 400 }}>
                              {o.label.length > 17 ? o.label.slice(0, 17) + '…' : o.label}
                            </div>
                            {isLatest && (
                              <div style={{
                                fontSize: '0.38rem', color: '#38bdf8',
                                marginTop: 3, fontWeight: 700, opacity: 0.65,
