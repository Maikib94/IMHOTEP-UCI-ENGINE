// src/components/picco/PiCCOQuickDrawer.tsx
//
// Drawer siempre-presente (no-modal, sin backdrop) cuando invasiveMode==='picco'.
// Reemplaza PiCCOQuickAccessPanel — renderizado como panel lateral fijo.
// Parámetros seleccionables; persiste en localStorage via useUIStore.piccoQuickParams.

import React, { memo } from 'react';
import { useMonitoringStore, type PiCCOSnapshot } from '../../store/useMonitoringStore';
import { useUIStore }   from '../../store/useUIStore';
import { formatVital }  from '../../utils/formatVital';

interface PiccoParam {
  id:     keyof PiCCOSnapshot;
  label:  string;
  unit:   string;
  lo:     number;
  hi:     number;
  digits: number;
}

const PICCO_PARAMS: PiccoParam[] = [
  { id: 'ci',    label: 'CI',    unit: 'L/min/m²', lo: 3.0, hi: 5.0, digits: 1 },
  { id: 'gedi',  label: 'GEDI',  unit: 'mL/m²',    lo: 680, hi: 800, digits: 0 },
  { id: 'evlwi', label: 'ELWI',  unit: 'mL/kg',    lo: 3,   hi: 7,   digits: 1 },
  { id: 'svv',   label: 'SVV',   unit: '%',        lo: 0,   hi: 12,  digits: 0 },
  { id: 'pvpi',  label: 'PVPI',  unit: '',         lo: 1,   hi: 3,   digits: 1 },
  { id: 'gef',   label: 'GEF',   unit: '%',        lo: 25,  hi: 35,  digits: 0 },
  { id: 'cfi',   label: 'CFI',   unit: '/min',     lo: 4.5, hi: 6.5, digits: 1 },
  { id: 'cpi',   label: 'CPI',   unit: 'W/m²',     lo: 0.5, hi: 0.7, digits: 1 },
  { id: 'scvo2', label: 'ScvO₂', unit: '%',        lo: 70,  hi: 80,  digits: 0 },
  { id: 'do2i',  label: 'DO₂I',  unit: 'mL/m²',   lo: 300, hi: 650, digits: 0 },
  { id: 'co',    label: 'GC',    unit: 'L/min',    lo: 4,   hi: 8,   digits: 1 },
  { id: 'svri',  label: 'IRVS',  unit: 'dyn·s·m²', lo: 800, hi: 1600,digits: 0 },
];

const DEFAULT_VISIBLE = ['ci', 'gedi', 'evlwi', 'svv'];

function ledColor(val: number, lo: number, hi: number): string {
  const m = (hi - lo) * 0.15;
  if (val < lo - m || val > hi + m) return '#f87171';
  if (val < lo || val > hi) return '#f59e0b';
  return '#10b981';
}

// ─── Single param row ─────────────────────────────────────────────────────────

const ParamRow = memo(function ParamRow({ p, val }: { p: PiccoParam; val: number }) {
  const color   = ledColor(val, p.lo, p.hi);
  const display = formatVital(val, { min: p.lo * 0.2, max: p.hi * 3, digits: p.digits });

  return (
    <div className="flex items-center justify-between px-3 py-1.5 border-b border-white/5">
      <div>
        <div className="text-[0.44rem] text-slate-500 font-mono uppercase tracking-wider">{p.label}</div>
        {p.unit && <div className="text-[0.36rem] text-slate-700">{p.unit}</div>}
      </div>
      <div style={{ color }} className="text-sm font-black font-mono">
        {display}
        <div
          className="w-1.5 h-1.5 rounded-full inline-block ml-1.5 mb-0.5"
          style={{ background: color, boxShadow: `0 0 6px ${color}` }}
        />
      </div>
    </div>
  );
});

// ─── Main drawer ──────────────────────────────────────────────────────────────

const PiCCOQuickDrawer = memo(function PiCCOQuickDrawer() {
  const mode             = useMonitoringStore(s => s.invasiveMode);
  const snap             = useMonitoringStore(s => s.piccoSnapshot);
  const startTD          = useMonitoringStore(s => s.startThermodilution);
  const alarmActive      = useMonitoringStore(s => s.thermodilutionAlarmActive);
  const piccoQuickParams = useUIStore(s => s.piccoQuickParams);
  const toggleParam      = useUIStore(s => s.togglePiccoQuickParam);
  const [showCfg, setShowCfg] = React.useState(false);

  if (mode !== 'picco') return null;

  const visible = piccoQuickParams.length > 0 ? piccoQuickParams : DEFAULT_VISIBLE;
  const params  = PICCO_PARAMS.filter(p => visible.includes(p.id as string));

  return (
    <div
      className="fixed right-0 top-0 h-full z-[200] flex flex-col border-l border-white/5"
      style={{
        width: 240,
        background: 'linear-gradient(180deg, #080d1a, #040710)',
        boxShadow: '-8px 0 30px rgba(0,0,0,0.5)',
      }}
    >
      {/* Header */}
      <div className="flex items-center justify-between px-3 py-2 border-b border-white/5 shrink-0">
        <div>
          <div className="text-[0.5rem] font-black uppercase tracking-[0.18em] text-violet-400">PiCCO</div>
          <div className="text-[0.38rem] text-slate-600 font-mono">Quick Access</div>
        </div>
        <button
          type="button"
          onClick={() => setShowCfg(v => !v)}
          className={`text-[0.55rem] cursor-pointer px-1.5 py-0.5 rounded border transition-all ${
            showCfg ? 'border-violet-500/50 text-violet-400' : 'border-white/5 text-slate-600 hover:text-slate-300'
          }`}
          title="Configurar parámetros visibles"
        >⚙</button>
      </div>

      {/* Config overlay */}
      {showCfg && (
        <div className="px-3 py-2 border-b border-white/5 bg-black/30 shrink-0">
          <div className="text-[0.42rem] font-black text-slate-400 uppercase tracking-wider mb-1.5">
            Parámetros visibles
          </div>
          <div className="grid grid-cols-2 gap-1">
            {PICCO_PARAMS.map(p => {
              const active = visible.includes(p.id as string);
              return (
                <button
                  key={p.id}
                  type="button"
                  onClick={() => toggleParam(p.id as string)}
                  className="px-1.5 py-1 rounded text-[0.42rem] font-bold cursor-pointer transition-all text-left"
                  style={{
                    background:  active ? 'rgba(139,92,246,0.2)' : 'rgba(0,0,0,0.3)',
                    border:      `1px solid ${active ? 'rgba(139,92,246,0.4)' : 'rgba(255,255,255,0.06)'}`,
                    color:       active ? '#c4b5fd' : '#475569',
                  }}
                >
                  {p.label}
                </button>
              );
            })}
          </div>
        </div>
      )}

      {/* Params list */}
      <div className="flex-1 overflow-y-auto">
        {!snap ? (
          <div className="flex items-center justify-center h-32 text-slate-600 text-[0.48rem] text-center px-4">
            Sin datos PiCCO.
            <br />Presione TD para inicializar.
          </div>
        ) : params.map(p => {
          const val = snap[p.id];
          if (typeof val !== 'number') return null;
          return <ParamRow key={p.id} p={p} val={val} />;
        })}
      </div>

      {/* TD button footer */}
      <div className="px-3 py-2 border-t border-white/5 shrink-0">
        {alarmActive && (
          <div className="text-[0.42rem] text-red-400 font-mono animate-pulse text-center mb-1.5">
            ⚠ Recalibración requerida
          </div>
        )}
        <button
          type="button"
          onClick={() => startTD()}
          className="w-full py-1.5 rounded-lg border border-amber-500/40 bg-amber-900/20 text-amber-300 text-[0.5rem] font-black tracking-wider cursor-pointer hover:bg-amber-800/35 transition-all"
        >
          ◉ TERMODILUCIÓN
        </button>
      </div>
    </div>
  );
});

export default PiCCOQuickDrawer;
