                <PiCCOLabel x={240} y={82}  label="GEDI"  value={String(Math.round(snap.gedi))}   unit="mL/m²"  normal={[680, 800]} primary anchor="middle" />

                <PiCCOLabel x={188} y={212} label="GEF"   value={String(Math.round(snap.gef))}    unit="%"       normal={[25, 35]} />
