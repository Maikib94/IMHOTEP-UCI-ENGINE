/* AccordionSection.module.css
   Animación de altura suave usando grid-template-rows (0fr → 1fr).
   Funciona independientemente del contenido sin necesidad de conocer la altura. */

.wrapper {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 12px;
  cursor: pointer;
  user-select: none;
  background: transparent;
  border: none;
  width: 100%;
  text-align: left;
  gap: 6px;
}

.header:focus-visible {
  outline: 2px solid rgba(34, 211, 238, 0.6);
  outline-offset: -2px;
  border-radius: 4px;
}

.chevron {
  flex-shrink: 0;
  transition: transform 200ms ease;
  color: #64748b;
}

.chevron.expanded {
  transform: rotate(90deg);
}

.grid {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 200ms ease;
}

.grid.expanded {
  grid-template-rows: 1fr;
}

.inner {
  overflow: hidden;
}
