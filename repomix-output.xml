  fluidCat: 'cristaloide' | 'hemo';
  selFluid: FluidType;
  selVolume: number;
  bv: number;
  crystalloidAccum: number;
  prbcUnits: number;
  ffpUnits: number;
  ratio11Needed: boolean;
  onFluidCategoryChange: (cat: 'cristaloide' | 'hemo') => void;
  onFluidSelect: (fluid: FluidType) => void;
  onVolumeSelect: (vol: number) => void;
  onAdminister: () => void;
