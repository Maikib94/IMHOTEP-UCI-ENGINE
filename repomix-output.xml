          </div>
          <div className="text-slate-700 text-[0.8rem] tracking-[0.04em] mt-0.5">F2 para cerrar</div>
        </div>

        <div
          className="bg-black/30 rounded-lg p-2.5 shadow-[inset_2px_2px_6px_rgba(0,0,0,0.5)]"
