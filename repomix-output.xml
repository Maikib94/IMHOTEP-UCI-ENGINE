                            <div style={{
                              fontSize: '0.58rem', color: C_TS,
                              letterSpacing: '0.04em', fontWeight: 700,
                            }}>
                              {fmtTime(o.orderedAt)}
                              {instantResults && (
                                <span style={{ color: '#fbbf24', marginLeft: 4 }}>⚡</span>
