// src/components/clinical/AntiarrhythmicControls.tsx
//
// Panel de antiarrítmicos: 5 fármacos con DrugControlCard (▲▼ + BOLO).
// Layout idéntico al panel de vasopresores (InfusionControl estética).
// Spec 3.B: cada fármaco tiene botón BOLO (dosis preconfigurada) + ▲▼ infusión.
//
// PD routing:
//   amiodarone / digoxin : Hill model (CardiovascularEngine) + pd.hrDirect (PDSystemicEffects)
//   esmolol / metoprolol_iv / diltiazem_iv : pd.hrDirect + pd.beta1 solamente
//
// Referencias de dosis BOLO:
//   Amiodarona  150mg IV en 10min — AHA ACLS 2023
//   Digoxina    0.5mg IV — Kotecha JAMA 2020 (digitalizing dose)
//   Esmolol     500µg/kg = 35mg para 70kg — Schwartz Am J Cardiol 1985
//   Metoprolol  5mg IV en 2min — Goodman&Gilman 13ª; Kramer CCM 1997
//   Diltiazem   20mg IV en 2min — Ellenbogen JACC 1991; Siu CCM 2009

import React from 'react';
import { usePharmacologyStore } from '../../store/usePharmacologyStore';
import { PharmacologyEngine, DRUG_MAX_DOSES } from '../../core/PharmacologyEngine';
import { DrugControlCard } from './drugControls';

// ─── Concentración display con código de color por ventana terapéutica ─────────

interface ConcDisplayProps {
  cpRatio:     number;
  value:       string;
  unit:        string;
  loThreshold: number;
  hiThreshold: number;
}

function ConcDisplay({ cpRatio, value, unit, loThreshold, hiThreshold }: ConcDisplayProps) {
  const isToxic = cpRatio > hiThreshold;
  const isSub   = cpRatio < loThreshold && cpRatio > 0.01;
  const color   = isToxic ? 'text-red-400' : isSub ? 'text-yellow-400' : cpRatio > 0.01 ? 'text-emerald-400' : 'text-slate-500';
  const label   = isToxic ? '⚠ TÓX' : isSub ? '↓ SUB' : cpRatio > 0.01 ? '✓' : '—';
  const bg      = isToxic ? 'bg-red-900/20 border-red-800/50' : 'bg-slate-800/30 border-slate-700/30';
  return (
    <div className={`flex items-center gap-1 px-1.5 py-0.5 rounded border text-[0.42rem] font-mono font-bold ${bg} ${color}`}>
      {value} {unit} <span className="opacity-60 text-[0.38rem]">{label}</span>
    </div>
  );
}

// ─── Componente principal ──────────────────────────────────────────────────────

export default function AntiarrhythmicControls() {
  const plasmaConc  = usePharmacologyStore(s => s.plasmaConcentrations);
  const queueBolus  = usePharmacologyStore(s => s.queueBolusRatio);

  const amioRatio   = plasmaConc['amiodarone']    ?? 0;
  const digRatio    = plasmaConc['digoxin']        ?? 0;
  const esmolRatio  = plasmaConc['esmolol']        ?? 0;
  const metoRatio   = plasmaConc['metoprolol_iv']  ?? 0;
  const diltRatio   = plasmaConc['diltiazem_iv']   ?? 0;

  // Concentraciones en unidades clínicas (display únicamente)
  const amioMgL   = (amioRatio  * 1.5).toFixed(2);   // mg/L  terapéutico 1.0-2.5
  const digNgmL   = (digRatio   * 1.2).toFixed(2);   // ng/mL terapéutico 0.8-2.0
  const esmUgmL   = (esmolRatio * 0.8).toFixed(2);   // µg/mL terapéutico 0.4-1.2
  const metoNgmL  = (metoRatio  * 50 ).toFixed(0);   // ng/mL terapéutico 50-100
  const diltNgmL  = (diltRatio  * 90 ).toFixed(0);   // ng/mL terapéutico 50-200

  // ── Handlers de bolo ────────────────────────────────────────────────────────

  // Amiodarona 150mg en 10min (bolo lento AHA ACLS 2023)
  const handleAmioBolus = () => PharmacologyEngine.getInstance().queueSlowBolus('amiodarone', 150, 600);

  // Digoxina 0.5mg bolo instantáneo: cpRatio = 0.5/(0.01×36h) = 1.39
  const handleDigBolus = () => {
    const maxRate = DRUG_MAX_DOSES['digoxin'];
    const halfLifeH = 2160 / 60;
    queueBolus('digoxin', Math.min(0.5 / (maxRate * halfLifeH), 3.0));
  };

  // Esmolol 500µg/kg bolo (≈35mg para 70kg): cpRatio directo = 2.0 (visible, ultrashort)
  const handleEsmolBolus = () => queueBolus('esmolol', 2.0);

  // Metoprolol 5mg: cpRatio = 5/(2×4h) = 0.625
  const handleMetoBolus = () => {
    const maxRate = DRUG_MAX_DOSES['metoprolol_iv'];
    const halfLifeH = 240 / 60;
    queueBolus('metoprolol_iv', Math.min(5 / (maxRate * halfLifeH), 3.0));
  };

  // Diltiazem 20mg: cpRatio = 20/(10×3.67h) = 0.545
  const handleDiltBolus = () => {
    const maxRate = DRUG_MAX_DOSES['diltiazem_iv'];
    const halfLifeH = 220 / 60;
    queueBolus('diltiazem_iv', Math.min(20 / (maxRate * halfLifeH), 3.0));
  };

  // Steps: 10% del DRUG_MAX_DOSES para cada droga
  const amioStep  = Math.round(DRUG_MAX_DOSES['amiodarone']   * 0.1 * 10) / 10;    // 6 mg/h
  const digStep   = parseFloat((DRUG_MAX_DOSES['digoxin']     * 0.1).toFixed(4));   // 0.001 mg/h
  const esmolStep = Math.round(DRUG_MAX_DOSES['esmolol']       * 0.1);              // 20 µg/kg/min
  const metoStep  = parseFloat((DRUG_MAX_DOSES['metoprolol_iv']* 0.1).toFixed(2)); // 0.2 mg/h
  const diltStep  = parseFloat((DRUG_MAX_DOSES['diltiazem_iv'] * 0.1).toFixed(1)); // 1 mg/h

  return (
    <div className="p-3">

      {/* ── AMIODARONA ── */}
      <div className="flex items-center justify-between mb-1">
        <ConcDisplay cpRatio={amioRatio} value={amioMgL} unit="mg/L"
          loThreshold={0.33} hiThreshold={1.67} />
        <span className="text-[0.4rem] text-slate-600 font-mono">Cl. III · β · Ca²⁺ · Na⁺</span>
      </div>
      <DrugControlCard
        label="Amiodarona" drug="amiodarone" unit="mg/h"
        step={amioStep} bolusLabel="150mg/10min" onBolus={handleAmioBolus}
        colorTheme="violet" decimals={1}
      />

      {/* ── DIGOXINA ── */}
      <div className="flex items-center justify-between mb-1">
        <ConcDisplay cpRatio={digRatio} value={digNgmL} unit="ng/mL"
          loThreshold={0.67} hiThreshold={1.67} />
        <span className="text-[0.4rem] text-slate-600 font-mono">Cl. IV · vagotónico · inot+</span>
      </div>
      <DrugControlCard
        label="Digoxina" drug="digoxin" unit="mg/h"
        step={digStep} bolusLabel="0.5mg" onBolus={handleDigBolus}
        colorTheme="violet" decimals={3}
      />

      {/* ── ESMOLOL ── */}
      <div className="flex items-center justify-between mb-1">
        <ConcDisplay cpRatio={esmolRatio} value={esmUgmL} unit="µg/mL"
          loThreshold={0.50} hiThreshold={1.00} />
        <span className="text-[0.4rem] text-slate-600 font-mono">β₁ · t½=9min · ultrashort</span>
      </div>
      <DrugControlCard
        label="Esmolol" drug="esmolol" unit="µg/kg/m"
        step={esmolStep} bolusLabel="500µg/kg" onBolus={handleEsmolBolus}
        colorTheme="violet" decimals={0}
      />

      {/* ── METOPROLOL IV ── */}
      <div className="flex items-center justify-between mb-1">
        <ConcDisplay cpRatio={metoRatio} value={metoNgmL} unit="ng/mL"
          loThreshold={0.50} hiThreshold={1.20} />
        <span className="text-[0.4rem] text-slate-600 font-mono">β₁ · t½=4h · ACS/FA</span>
      </div>
      <DrugControlCard
        label="Metoprolol" drug="metoprolol_iv" unit="mg/h"
        step={metoStep} bolusLabel="5mg" onBolus={handleMetoBolus}
        colorTheme="violet" decimals={2}
      />

      {/* ── DILTIAZEM IV ── */}
      <div className="flex items-center justify-between mb-1">
        <ConcDisplay cpRatio={diltRatio} value={diltNgmL} unit="ng/mL"
          loThreshold={0.28} hiThreshold={1.10} />
        <span className="text-[0.4rem] text-slate-600 font-mono">Ca²⁺ BCC · FA/flutter · Siu2009</span>
      </div>
      <DrugControlCard
        label="Diltiazem" drug="diltiazem_iv" unit="mg/h"
        step={diltStep} bolusLabel="20mg" onBolus={handleDiltBolus}
        colorTheme="violet" decimals={1}
      />

    </div>
  );
}
</file>

