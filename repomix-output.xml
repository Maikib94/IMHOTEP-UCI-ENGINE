// src/components/PiCCOQuickAccessPanel.tsx
//
// Mini-panel de acceso rápido PiCCO con parámetros seleccionables.
// Espejo del "ACCESO RÁPIDO ARM" del ClinicalControlPanel.
// Persiste selección en localStorage.

import React from 'react';
import { useMonitoringStore, type PiCCOSnapshot } from '../store/useMonitoringStore';
import { useUIStore } from '../store/useUIStore';
import { formatVital } from '../utils/formatVital';

const MONO = "[font-family:'JetBrains_Mono',monospace]";

// ─── Catálogo de parámetros disponibles ──────────────────────────────────────

interface PiccoParam {
  id:     keyof PiCCOSnapshot;
  label:  string;
  unit:   string;
  lo:     number;
  hi:     number;
  digits: number;
}

const AVAILABLE_PICCO_PARAMS: PiccoParam[] = [
  { id: 'ci',    label: 'CI',    unit: 'L/min/m²', lo: 3.0, hi: 5.0, digits: 1 },
  { id: 'gedi',  label: 'GEDI',  unit: 'mL/m²',    lo: 680, hi: 800, digits: 0 },
  { id: 'evlwi', label: 'ELWI',  unit: 'mL/kg',    lo: 3,   hi: 7,   digits: 1 },
  { id: 'svv',   label: 'SVV',   unit: '%',        lo: 0,   hi: 12,  digits: 0 },
  { id: 'pvpi',  label: 'PVPI',  unit: '',         lo: 1,   hi: 3,   digits: 1 },
  { id: 'gef',   label: 'GEF',   unit: '%',        lo: 25,  hi: 35,  digits: 0 },
  { id: 'cfi',   label: 'CFI',   unit: '/min',     lo: 4.5, hi: 6.5, digits: 1 },
  { id: 'cpi',   label: 'CPI',   unit: 'W/m²',     lo: 0.5, hi: 0.7, digits: 1 },
  { id: 'scvo2', label: 'ScvO₂', unit: '%',        lo: 70,  hi: 80,  digits: 0 },
  { id: 'do2i',  label: 'DO2I',  unit: 'mL/m²',   lo: 300, hi: 650, digits: 0 },
];

function getColor(val: number, lo: number, hi: number): string {
  const margin = (hi - lo) * 0.15;
  if (val < lo - margin || val > hi + margin) return 'text-red-400';
  if (val < lo || val > hi) return 'text-amber-400';
  return 'text-emerald-400';
}

// ─── Card individual de parámetro ─────────────────────────────────────────────

function ParamCard({ p, val }: { p: PiccoParam; val: number }) {
  const color = getColor(val, p.lo, p.hi);
  const formatted = formatVital(val, { min: p.lo * 0.2, max: p.hi * 3, digits: p.digits });

  return (
    <div className="bg-black/40 rounded-lg p-1.5 border border-white/5">
      <div className="text-[0.42rem] text-slate-500 uppercase tracking-wider">{p.label}</div>
      <div className={`text-base font-black leading-none mt-0.5 ${MONO} ${color}`}>{formatted}</div>
      {p.unit && <div className="text-[0.38rem] text-slate-600 mt-0.5">{p.unit}</div>}
    </div>
  );
}

// ─── Componente principal ─────────────────────────────────────────────────────

export const PiCCOQuickAccessPanel: React.FC = () => {
  const mode             = useMonitoringStore(s => s.invasiveMode);
  const snap             = useMonitoringStore(s => s.piccoSnapshot);
  const startTD          = useMonitoringStore(s => s.startThermodilution);
  const alarmActive      = useMonitoringStore(s => s.thermodilutionAlarmActive);
  const piccoQuickParams = useUIStore(s => s.piccoQuickParams);
  const toggleParam      = useUIStore(s => s.togglePiccoQuickParam);
  const [showConfig, setShowConfig] = React.useState(false);

  if (mode !== 'picco') return null;

  const visibleParams = AVAILABLE_PICCO_PARAMS.filter(p => piccoQuickParams.includes(p.id));

  return (
    <div className="fixed bottom-4 right-4 z-40 bg-[#0b1120]/95 border border-violet-500/40 rounded-xl shadow-2xl backdrop-blur-sm w-60"
         style={{ boxShadow: '0 8px 32px rgba(0,0,0,0.6), 0 0 0 1px rgba(139,92,246,0.2)' }}>

      {/* Header */}
      <div className="flex items-center justify-between px-3 py-2 border-b border-violet-500/20">
        <span className={`text-violet-400 font-black text-[0.55rem] tracking-wider ${MONO}`}>
          ACCESO RÁPIDO PiCCO
        </span>
        <div className="flex items-center gap-1.5">
          {alarmActive && (
            <div className="w-2 h-2 rounded-full bg-red-500 animate-ping" />
          )}
          <button
            type="button"
            onClick={() => { startTD(); }}
            className="text-[0.45rem] font-black px-1.5 py-0.5 rounded border border-amber-500/50 text-amber-300 bg-amber-900/25 cursor-pointer hover:bg-amber-800/40"
          >
            ↻ TD
          </button>
          <button
            type="button"
            onClick={() => setShowConfig(v => !v)}
            className="text-[0.45rem] text-slate-400 hover:text-white cursor-pointer"
            title="Configurar parámetros visibles"
          >
            ⚙
          </button>
        </div>
      </div>

      {/* Config panel */}
      {showConfig && (
        <div className="px-3 py-2 border-b border-violet-500/20 bg-black/30">
          <div className="text-[0.42rem] text-slate-500 uppercase tracking-wider mb-1.5">
            Parámetros visibles
          </div>
          <div className="grid grid-cols-3 gap-1">
            {AVAILABLE_PICCO_PARAMS.map(p => (
              <button
                key={p.id}
                type="button"
                onClick={() => toggleParam(p.id)}
                className={`text-[0.42rem] py-0.5 rounded border cursor-pointer transition-all ${
                  piccoQuickParams.includes(p.id)
                    ? 'bg-violet-500/25 border-violet-400/50 text-violet-200'
                    : 'bg-black/30 border-white/10 text-slate-500'
                }`}
              >
                {p.label}
              </button>
            ))}
          </div>
        </div>
      )}

      {/* Parameter grid */}
      <div className={`grid grid-cols-2 gap-1.5 p-2 ${MONO}`}>
        {snap
          ? visibleParams.map(p => (
              <ParamCard key={p.id} p={p} val={snap[p.id] as number} />
            ))
          : (
            <div className="col-span-2 text-center text-[0.48rem] text-slate-500 py-3">
              Realice una termodilución
            </div>
          )
        }
      </div>
    </div>
  );
};
</file>

